{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "name": "ase",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ase"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Cron fires every minute → src/worker.ts scheduled() handler runs trading agents
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
