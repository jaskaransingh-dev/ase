{
  "name": "ase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' eslint --cache --cache-location node_modules/.cache/eslint app lib components scripts",
    "lint:all": "NODE_OPTIONS='--max-old-space-size=8192' eslint --cache --cache-location node_modules/.cache/eslint .",
    "test:blocks": "tsx scripts/test-blocks.ts",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && wrangler pages deploy .open-next --project-name ase",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/auth-helpers-react": "^0.15.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "ai": "^6.0.168",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.1",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reactflow": "^11.11.4",
    "rechart": "^0.0.1",
    "recharts": "^3.8.0",
    "resend": "^6.9.4",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.77.0"
  }
}
