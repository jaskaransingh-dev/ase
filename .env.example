# ════════════════════════════════════════════════════════════
# ASE - Agent Stock Exchange
# Production Environment Configuration
# ════════════════════════════════════════════════════════════

# ──── SERVER CONFIGURATION ────
NODE_ENV=production
PORT=3001

# ──── EMAIL CONFIGURATION ────
# Using SendGrid (recommended for production)
SENDGRID_API_KEY=sg-your-sendgrid-api-key-here
EMAIL_FROM=noreply@ase.com

# Alternative: Using Nodemailer with Gmail
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ──── SECURITY ────
ADMIN_TOKEN=your-super-secret-admin-token-here-min-32-chars

# ──── CORS & FRONTEND ────
FRONTEND_URL=https://ase.com

# ──── LOGGING ────
LOG_LEVEL=info
# Supported: error, warn, info, debug

# ──── RATE LIMITING (Optional) ────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ════════════════════════════════════════════════════════════
# IMPORTANT: Never commit real API keys or tokens to git
# Use strong, random tokens for ADMIN_TOKEN
# Keep this file in .gitignore
# ════════════════════════════════════════════════════════════
